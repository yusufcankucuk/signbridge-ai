{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signbridge.local/schemas/prediction-v1.json",
  "title": "SignBridgePrediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classId",
    "displayText",
    "confidence",
    "alternatives",
    "isLowConfidence",
    "predictionMode",
    "modelVersion",
    "preprocessingVersion",
    "vocabularyVersion",
    "decisionPolicyVersion",
    "rejectionReason",
    "requiresConfirmation"
  ],
  "properties": {
    "classId": {"type": ["string", "null"]},
    "displayText": {"type": "string", "minLength": 1},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "alternatives": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "isLowConfidence": {"type": "boolean"},
    "predictionMode": {"enum": ["model", "mock", "manual"]},
    "modelVersion": {"type": ["string", "null"]},
    "preprocessingVersion": {"type": "string"},
    "vocabularyVersion": {"type": "string"},
    "decisionPolicyVersion": {"type": "string", "minLength": 1},
    "rejectionReason": {"type": ["string", "null"], "enum": ["low_score", "ambiguous_prediction", null]},
    "requiresConfirmation": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"isLowConfidence": {"const": true}}},
      "then": {
        "properties": {
          "classId": {"type": "null"},
          "rejectionReason": {"type": "string"},
          "requiresConfirmation": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"predictionMode": {"const": "manual"}}},
      "then": {
        "properties": {
          "confidence": {"type": "null"},
          "modelVersion": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"predictionMode": {"const": "model"}}},
      "then": {"properties": {"modelVersion": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"isLowConfidence": {"const": false}, "predictionMode": {"const": "model"}}},
      "then": {"properties": {"rejectionReason": {"type": "null"}, "requiresConfirmation": {"const": true}}}
    }
  ]
}
