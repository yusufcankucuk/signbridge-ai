# Uygulama Ayarları
PORT=3000
NODE_ENV=development

# API Ayarları (Örnek)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Huawei Cloud & ModelArts (Bu değerler sadece yerel .env dosyasında doldurulacaktır)
HUAWEI_ACCESS_KEY=your_access_key_here
HUAWEI_SECRET_KEY=your_secret_key_here
HUAWEI_PROJECT_ID=your_project_id_here
MODELARTS_ENDPOINT=your_endpoint_url_here