# SignBridge birleşik 30 sınıflı deneysel kamera modeli
WEB_PORT=3000
SESSION_STORE=memory

# Tam eğitimden sonra oluşan yeni, ayrı model klasörü.
MODEL_DIR=./ai-training/outputs/unified30
ALLOW_MANUAL_ONLY=true
LABELS_FILE=labels.signbridge30.json
DECISION_POLICY_FILE=decision_policy.unified30-team-camera.json

AI_PROVIDER=local
AI_FALLBACK_PROVIDER=none
AI_EXPECTED_MODEL_VERSION=signbridge-unified30-bigru-v0.2.0
AI_EXPECTED_PREPROCESSING_VERSION=landmark46-v1
AI_EXPECTED_VOCABULARY_VERSION=signbridge30-v1
CAMERA_MOTION_POLICY_ENABLED=true
CAMERA_MINIMUM_MOTION_SCORE=0.12
# 55 kamera denemesi ekranı: http://localhost:3000/camera-trials
CAMERA_TRIALS_ENABLED=true

MODELARTS_ENABLED=false
MODELARTS_ENDPOINT=
MODELARTS_AUTH_TOKEN=

# Eğitim için gerçek yerel veri kökü. Windows yollarında ileri eğik çizgi kullanın.
SIGNBRIDGE_DATA_ROOT=C:/Users/yunusozdemir/Desktop/huawei staj/ai icin kullanilacak kaynaklar
