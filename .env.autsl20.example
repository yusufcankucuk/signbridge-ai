# Eski AUTSL-20 modeli (20 genel kelime). Kurulum: node scripts/install-model.mjs --model autsl20
# Web
WEB_PORT=3000

# Yerel demo dış servis gerektirmez ve yeniden başlatmada temizlenen belleği kullanır.
SESSION_STORE=memory

# Gerçek Supabase kullanacaksanız SESSION_STORE=supabase yapın. Bu anahtar yalnız
# sunucu ortamına konur; tarayıcıya ve Git'e eklenmez.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Kurulacak/kullanılacak model ve klasörü.
SIGNBRIDGE_MODEL=autsl20
MODEL_DIR=./ai-training/outputs
LABELS_FILE=labels.autsl20.json
# İnternetsiz model-setup için konteynerde görülebilen bir yol verin; normalde boş bırakın.
MODEL_ARCHIVE=
# Model yoksa servis açık ve sağlıklı kalır, fakat yalnız manuel seçim kullanılabilir.
ALLOW_MANUAL_ONLY=true
# Doğrulanmış model varsa ekip teknik demosunda kamera doğrudan açılır.
# Güvenli manuel demo için decision_policy.json ve false değerlerini kullanın.
DECISION_POLICY_FILE=decision_policy.team-camera.json

# Varsayılan çalışma biçimi: yerel FastAPI
AI_PROVIDER=local
AI_FALLBACK_PROVIDER=none
AI_EXPECTED_MODEL_VERSION=autsl20-bigru-v0.1.0
AI_EXPECTED_PREPROCESSING_VERSION=landmark46-v1
AI_EXPECTED_VOCABULARY_VERSION=autsl20-v1
# Ekip teknik kamera demosu; final yayın kararı ayrıca ölçüm raporuyla verilir.
CAMERA_MOTION_POLICY_ENABLED=true
CAMERA_MINIMUM_MOTION_SCORE=0.12

# Huawei hazır tutulur ancak bu bayrak true yapılana kadar kullanılamaz.
# Etkinleştirirken AI_PROVIDER=modelarts yapın. Gerçek değerleri Git'e eklemeyin.
MODELARTS_ENABLED=false
MODELARTS_ENDPOINT=https://your-modelarts-inference-endpoint
MODELARTS_AUTH_TOKEN=your_temporary_iam_token

# Yalnızca "training" profili için gerekir. Windows'ta ileri eğik çizgi kullanın.
SIGNBRIDGE_DATA_ROOT=C:/path/to/signbridge-data
