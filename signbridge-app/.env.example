# Uygulama Ayarları
PORT=3000
NODE_ENV=development

# API Ayarları (Örnek)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Varsayılan çalışma biçimi: yerel FastAPI
AI_PROVIDER=local
AI_FALLBACK_PROVIDER=none
AI_LOCAL_URL=http://localhost:8000
# Varsayılan model: 20 kelime + 15 belirti avatarı. Eski AUTSL-20 modeli için
# autsl20-bigru-v0.1.0 ve autsl20-v1 yazın.
AI_EXPECTED_MODEL_VERSION=signbridge-unified34-bigru-v0.3.0
AI_EXPECTED_PREPROCESSING_VERSION=landmark46-v1
AI_EXPECTED_VOCABULARY_VERSION=signbridge34-v1
# Ekip teknik kamera demosunda model doğrulanmışsa açılır; model yoksa manuel moda düşer.
CAMERA_MOTION_POLICY_ENABLED=true
CAMERA_MINIMUM_MOTION_SCORE=0.12
CAMERA_TRIALS_ENABLED=true
SPEECH_PROVIDER=mock

# Huawei ModelArts hazır tutulur ancak açıkça etkinleştirilene kadar kullanılmaz.
# Etkinleştirmek için ayrıca AI_PROVIDER=modelarts yapın. NEXT_PUBLIC_ kullanmayın.
MODELARTS_ENABLED=false
MODELARTS_ENDPOINT=https://your-modelarts-inference-endpoint
MODELARTS_AUTH_TOKEN=your_temporary_iam_token

# Yerel demo varsayılanı; uygulama yeniden başlatılınca görüşmeler silinir.
SESSION_STORE=memory

# Supabase (yalnız Next.js sunucu route'ları kullanır). Supabase modu için
# SESSION_STORE=supabase yapın. Service role anahtarını NEXT_PUBLIC_ ile yazmayın.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
