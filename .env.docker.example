# Web
WEB_PORT=3000

# Supabase Project Settings > API bölümünden alınır.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Eğitilmiş model dosyalarının bulunduğu klasör.
MODEL_DIR=./ai-training/outputs

# Varsayılan çalışma biçimi: yerel FastAPI
AI_PROVIDER=local
AI_FALLBACK_PROVIDER=none
AI_EXPECTED_MODEL_VERSION=autsl20-bigru-v0.1.0
AI_EXPECTED_PREPROCESSING_VERSION=landmark46-v1
AI_EXPECTED_VOCABULARY_VERSION=autsl20-v1

# Huawei hazır tutulur ancak bu bayrak true yapılana kadar kullanılamaz.
# Etkinleştirirken AI_PROVIDER=modelarts yapın. Gerçek değerleri Git'e eklemeyin.
MODELARTS_ENABLED=false
MODELARTS_ENDPOINT=https://your-modelarts-inference-endpoint
MODELARTS_AUTH_TOKEN=your_temporary_iam_token

# Yalnızca "training" profili için gerekir. Windows'ta ileri eğik çizgi kullanın.
SIGNBRIDGE_DATA_ROOT=C:/path/to/signbridge-data
